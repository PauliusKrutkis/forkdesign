{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "project": ["src/**/*.{ts,tsx,css}"],
      // `@vitejs/plugin-react` is used by tests/fixtures/playground/vite.config.ts,
      // outside the scanned `src/**` project glob, so knip can't see the usage.
      "ignoreDependencies": [
        "@biomejs/biome",
        "tailwindcss",
        "@vitejs/plugin-react"
      ],
      "ignore": ["src/client/ui/**", "src/forkdesign.css", "src/styles.css"]
    },
    "examples/basic-vite": {}
  },
  "ignoreIssues": {
    "src/client/settings.ts": ["exports"],
    "src/server/agent/config.ts": ["exports"],
    "src/server/agent/cursor-models.ts": ["exports"],
    "src/server/agent/models.ts": ["exports"],
    "src/server/plugins/comments.ts": ["types"],
    "src/server/iterations/manifest.ts": ["exports"],
    "src/server/api/comments/parse-body.ts": ["types"]
  }
}
