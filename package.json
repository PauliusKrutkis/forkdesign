{
  "name": "redline",
  "version": "0.1.0",
  "description": "Inline design feedback for Vite + React playgrounds — comments live in source as JSX markers with per-comment iteration snapshots on disk.",
  "type": "module",
  "license": "MIT",
  "author": "Paulius Krutkis",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PauliusKrutkis/redline.git"
  },
  "bugs": "https://github.com/PauliusKrutkis/redline/issues",
  "homepage": "https://github.com/PauliusKrutkis/redline#readme",
  "sideEffects": ["**/*.css"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "pnpm build",
    "prepublishOnly": "pnpm test && pnpm build"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./plugin": {
      "source": "./src/plugin/index.ts",
      "types": {
        "import": "./dist/plugin/index.d.ts",
        "require": "./dist/plugin/index.d.cts"
      },
      "import": "./dist/plugin/index.mjs",
      "require": "./dist/plugin/index.cjs"
    },
    "./styles.css": "./src/styles.css",
    "./tailwind.content": {
      "import": "./tailwind.content.js",
      "require": "./tailwind.content.js",
      "default": "./tailwind.content.js"
    }
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "vite": "^8.0.0"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.150",
    "@babel/parser": "^7.29.3",
    "@babel/traverse": "^7.29.0",
    "@babel/types": "^7.29.0",
    "html-to-image": "^1.11.13",
    "recast": "^0.23.11"
  },
  "devDependencies": {
    "@types/babel__traverse": "^7.28.0",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "happy-dom": "^20.9.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tsup": "^8.3.0",
    "typescript": "~6.0.2",
    "vitest": "^4.1.7"
  },
  "files": ["dist", "src/styles.css", "tailwind.content.js", "README.md", "LICENSE"],
  "keywords": [
    "vite",
    "react",
    "design",
    "feedback",
    "comments",
    "playground",
    "prototype",
    "ai",
    "claude"
  ],
  "engines": {
    "node": ">=20"
  }
}
