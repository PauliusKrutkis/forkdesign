{
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.177",
    "@babel/parser": "^7.29.3",
    "@babel/traverse": "^7.29.0",
    "@babel/types": "^7.29.0",
    "@radix-ui/react-dialog": "^1.1.16",
    "@radix-ui/react-label": "^2.1.9",
    "@radix-ui/react-slot": "^1.2.5",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.17.0",
    "recast": "^0.23.11",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@playwright/test": "^1.50.0",
    "@tailwindcss/cli": "^4.3.0",
    "@types/babel__traverse": "^7.28.0",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "happy-dom": "^20.10.3",
    "knip": "^6.14.2",
    "postcss": "^8.5.15",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.1",
    "tsup": "^8.3.0",
    "typescript": "~6.0.2",
    "ultracite": "7.8.1",
    "vitest": "^4.1.8"
  },
  "name": "forkdesign",
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^8.0.0"
  },
  "scripts": {
    "build": "tsup && pnpm build:css",
    "build:css": "tailwindcss -i ./src/forkdesign.css -o ./dist/styles.css --minify && node ./scripts/unwrap-css-layers.mjs ./dist/styles.css",
    "check": "ultracite check",
    "dev": "tsup --watch",
    "example": "pnpm --dir examples/basic-vite dev",
    "knip": "knip",
    "lint": "ultracite check",
    "lint:fix": "ultracite fix",
    "prepublishOnly": "pnpm check && pnpm typecheck && pnpm test && pnpm build",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "test:watch": "vitest --project unit",
    "typecheck": "tsc --noEmit",
    "fix": "ultracite fix"
  },
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.0",
  "description": "Local-first AI design iteration for Vite + React — comment on a component, get source-backed variants, and keep the whole history in your repo. Every change is a git diff.",
  "license": "MIT",
  "author": "Paulius Krutkis",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PauliusKrutkis/forkdesign.git"
  },
  "bugs": "https://github.com/PauliusKrutkis/forkdesign/issues",
  "homepage": "https://github.com/PauliusKrutkis/forkdesign#readme",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./plugin": {
      "source": "./src/plugin/index.ts",
      "types": {
        "import": "./dist/plugin/index.d.ts",
        "require": "./dist/plugin/index.d.cts"
      },
      "import": "./dist/plugin/index.mjs",
      "require": "./dist/plugin/index.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist/**/*.mjs",
    "dist/**/*.cjs",
    "dist/**/*.d.ts",
    "dist/**/*.d.cts",
    "dist/styles.css",
    "docs/assets",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "keywords": [
    "vite",
    "react",
    "design",
    "variants",
    "iteration",
    "git",
    "local-first",
    "feedback",
    "comments",
    "playground",
    "prototype",
    "ai",
    "claude"
  ],
  "engines": {
    "node": ">=20"
  }
}
